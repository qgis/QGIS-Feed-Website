# Copy this file to settings_local_override.py and fill in the values below.
#
# It holds the secrets, plus the few settings that have no environment
# variable. DEBUG, DOMAIN_NAME, MEDIA_ROOT, STATIC_ROOT, GEOIP_PATH, the
# database connection and SENTRY_RATE all come from the environment instead.
#
# This file is applied last, so anything named here wins over the environment,
# including an empty value. Only list settings you actually want to set.
#
# The real file is git-ignored. Keep this template in step with it, and never
# commit a real value.

# Generate with: openssl rand -base64 48
SECRET_KEY = 'change-me-before-deploying'

# E-mail
EMAIL_BACKEND = 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST = 'smtp.resend.com'
EMAIL_PORT = 587
EMAIL_USE_TLS = True
EMAIL_HOST_USER = 'resend'
EMAIL_HOST_PASSWORD = ''
EMAIL_SUBJECT_PREFIX = '[QGIS Feed] '
DEFAULT_FROM_EMAIL = 'no-reply-feed@qgis.org'

# Social syndication
MASTODON_ACCESS_TOKEN = ''
BLUESKY_PASSWORD = ''
TELEGRAM_BOT_TOKEN = ''

# Records returned by the feed API. The default is 20, and it is there to limit
# the cost of a request.
QGISFEED_MAX_RECORDS = 20
