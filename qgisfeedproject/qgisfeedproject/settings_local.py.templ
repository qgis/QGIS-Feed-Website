# Copy this file to settings_local.py, in this directory:
#
#   cp settings_local.py.templ settings_local.py
#
# Docker Compose pins the older name, so copy it to
# settings_local_override.py instead if that is the stack you are running.
#
# It is git-ignored and entirely optional: the development stack runs with none
# of it set. settings.py applies it last, so anything here wins over the
# environment.
#
# Keep this template in step with the real file, and never commit a real value.

# Run the development site against a copy of the live data. Restore a dump with
# db-restore, and point MEDIA_ROOT at the uploads that go with it.
# MEDIA_ROOT = '/home/you/data/feed.qgis.org/media'
# QGISFEED_BACKUP_DIR = '/home/you/data/feed.qgis.org/dbbackups'

# The committed key in settings.py is public, so replace it anywhere reachable.
# Generate with: openssl rand -base64 48
# SECRET_KEY = 'change-me-before-deploying'

# E-mail
# EMAIL_BACKEND = 'django.core.mail.backends.smtp.EmailBackend'
# EMAIL_HOST = 'smtp.resend.com'
# EMAIL_PORT = 587
# EMAIL_USE_TLS = True
# EMAIL_HOST_USER = 'resend'
# EMAIL_HOST_PASSWORD = ''
# EMAIL_SUBJECT_PREFIX = '[QGIS Feed] '
# DEFAULT_FROM_EMAIL = 'no-reply-feed@qgis.org'

# Social syndication
# MASTODON_ACCESS_TOKEN = ''
# BLUESKY_PASSWORD = ''
# TELEGRAM_BOT_TOKEN = ''

# Records returned by the feed API. The default is 20, and it is there to limit
# the cost of a request.
# QGISFEED_MAX_RECORDS = 20
